<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="ChefMate System Testing" parallel="false" thread-count="1">
    <!--
    tests.xml
    Suite Kiểm thử tự động tất cả bộ testcase — ChefMate Android
    Chạy: mvn clean test
        allure serve target/allure-results ==> cũ
        allure open target/allure-report ==> hay dùng open manual report thay cho auto report
    leenhj caif apk vaof emulator : adb install C:\APK\BepTroLy-Bepes_v2.2.0.apk
    -->
    <!-- ✅ LISTENERS PHẢI CÓ -->
    <listeners>
        <listener class-name="core.listener.AllureTestListener"/>
    </listeners>

    <test name="System Testing">
        <classes>
                <class name="tests.LoginTest"/>
                <class name="tests.RegistrationTest"/>
                <class name="tests.LogoutTest"/>
                <class name="tests.EditProfileTest"/>
                <class name="tests.ChangePasswordTest"/>
                <class name="tests.RecipeDisplayTest"/>
                <class name="tests.SearchTest"/>
                <class name="tests.SaveRecipeTest"/>
                <class name="tests.FridgeTest"/>
                <class name="tests.EditRecipeTest"/>
                <class name="tests.ShoppingBuilderTest"/>
                <class name="tests.ShoppingListTest"/>
                <class name="tests.ShoppingHistoryTest"/>
                <class name="tests.AddRecipeTest"/>
                <class name="tests.BepesAITest"/>
                <class name="e2e.E2EIntegrationTest"/>
        </classes>
    </test>
</suite>