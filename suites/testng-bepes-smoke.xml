<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Chefmate Smoke Suite" verbose="1" parallel="none">
    <!--
            testng-e2e-integration.xml
            Suite kiểm thử tích hợp E2E — ChefMate Android
            Chạy: mvn test -DsuiteXmlFile=suites/testng-e2e-integration.xml
                    allure serve target/allure-results ==> cũ
                    allure open target/allure-report ==> hay dùng mở thủ công
              Chu thich hay dung : Ctrl + Shift + / or Ctrl + /
    -->

    <!-- ✅ LISTENERS PHẢI CÓ -->
    <listeners>
        <listener class-name="core.listener.AllureTestListener"/>
    </listeners>

    <!-- ════════════════════════════════════════════════
             GROUP 1: LUỒNG CỐT LÕI (SMOKE TRƯỚC KHI E2E)
        ════════════════════════════════════════════════ -->
    <test name="Group 01" enabled="true">
        <classes>
            <class name="tests.LoginTest">
                <methods>
                    <include name="DangNhap_TC_01"/>
                    <include name="DangNhap_TC_02"/>
                    <include name="DangNhap_TC_07"/>
                </methods>
            </class>
            <class name="tests.LogoutTest">
                <methods>
                    <include name="DangXuat_TC_01"/>
                    <include name="DangXuat_TC_04"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ════════════════════════════════════════════════
        GROUP 2: LUỒNG XEM + THÊM + SỬA + XÓA CÔNG THỨC
   ════════════════════════════════════════════════ -->
    <test name="Group 02" enabled="true">
        <classes>
            <class name="tests.RecipeDisplayTest">
                <methods>
                    <include name="RecipeDisplay_TC_01"/>
                    <include name="RecipeDisplay_TC_02"/>
                    <include name="RecipeDisplay_TC_03"/>
                </methods>
            </class>
            <class name="tests.AddRecipeTest">
                <methods>
                    <include name="RecipeCreate_TC_02"/>
                </methods>
            </class>
            <class name="tests.EditRecipeTest">
                <methods>
                    <include name="RecipeEdit_TC_01"/>
                    <include name="RecipeEdit_TC_02"/>
                    <include name="RecipeEdit_TC_06"/>
                    <include name="RecipeEdit_TC_09"/>
                </methods>
            </class>
            <class name="tests.SaveRecipeTest">
                <methods>
                    <include name="RecipeDelete_TC_01"/>
                    <include name="RecipeDelete_TC_02"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ════════════════════════════════════════════════
         GROUP 3: LUỒNG TÌM KIẾM
    ════════════════════════════════════════════════ -->
    <test name="Group 03" enabled="true">
        <classes>
            <class name="tests.SearchTest">
                <methods>
                    <include name="RecipeName_TC_01"/>
                    <include name="RecipeName_TC_02"/>
                    <include name="RecipeName_TC_07"/>
                    <include name="RecipeTag_TC_01"/>
                    <include name="RecipeTag_TC_03"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ════════════════════════════════════════════════
         GROUP 4: LUỒNG LƯU / LIKE / SHARE / XÓA
    ════════════════════════════════════════════════ -->
    <test name="Group 04" enabled="true">
        <classes>
            <class name="tests.SaveRecipeTest">
                <methods>
                    <include name="RecipeSave_TC_01"/>
                    <include name="RecipeSave_TC_02"/>
                    <include name="RecipeLike_TC_01"/>
                    <include name="RecipeComment_TC_01"/>
                    <include name="RecipeShare_TC_01"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ════════════════════════════════════════════════
         GROUP 5: LUỒNG TỦ LẠNH
    ════════════════════════════════════════════════ -->
    <test name="Group 05" enabled="true">
        <classes>
            <class name="tests.FridgeTest">
                <methods>
                    <include name="Fridge_TC_01"/>
                    <include name="Fridge_TC_02"/>
                    <include name="Fridge_TC_03"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ════════════════════════════════════════════════
         GROUP 6: LUỒNG BEPES AI
    ════════════════════════════════════════════════ -->
    <test name="Group 06" enabled="true">
        <classes>
            <class name="tests.BepesAITest">
                <methods>
                    <include name="BepesAI_TC_01"/>
                    <include name="BepesAI_TC_03"/>
                    <include name="BepesAI_TC_04"/>
                    <include name="BepesAI_TC_05"/>
                    <include name="BepesAI_TC_07"/>
                    <include name="BepesAI_TC_08"/>
                    <include name="BepesAI_TC_09"/>
                    <include name="BepesAI_TC_11"/>
                    <include name="BepesAI_TC_12"/>
                    <include name="BepesAI_TC_13"/>
                    <include name="BepesAI_TC_14"/>
                    <include name="BepesAI_TC_15"/>
                    <include name="BepesAI_TC_16"/>
                    <include name="BepesAI_TC_24"/>
                    <include name="BepesAI_TC_25"/>
                    <include name="BepesAI_TC_27"/>
                    <include name="BepesAI_TC_29"/>
                    <include name="BepesAI_TC_33"/>

                </methods>
            </class>
        </classes>
    </test>

    <!-- ════════════════════════════════════════════════
         GROUP 7: LUỒNG SHOPPING
    ════════════════════════════════════════════════ -->
    <test name="Group 07" enabled="true">
        <classes>
            <class name="tests.ShoppingBuilderTest">
                <methods>
                    <include name="RecipeShopping_TC_01"/>
                    <include name="RecipeShopping_TC_02"/>
                    <include name="RecipeShopping_TC_03"/>
                    <include name="RecipeShopping_TC_04"/>
                    <include name="RecipeShopping_TC_09"/>
                </methods>
            </class>
            <class name="tests.ShoppingListTest">
                <methods>
                    <include name="RecipeShoppingManage_TC_04"/>
                    <include name="RecipeShoppingManage_TC_05"/>
                    <include name="RecipeShoppingManage_TC_06"/>
                    <include name="RecipeShoppingManage_TC_07"/>
                    <include name="RecipeShoppingManage_TC_13"/>
                </methods>
            </class>
            <class name="tests.ShoppingHistoryTest">
                <methods>
                    <include name="RecipeHistoryShopping_TC_01"/>
                    <include name="RecipeHistoryShopping_TC_02"/>
                    <include name="RecipeHistoryShopping_TC_05"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
